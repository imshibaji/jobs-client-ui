---
const { data = [] } = Astro.props;

// sort data by id field
data.sort((a: any, b: any) => {
    return a.id - b.id;
});

const filterData = data.length > 4 ? data.slice(data.length - 4) : data;
---
<div class="mt-2">
    <div class="flex justify-between items-center mx-3">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Recent Jobs</h2>
        <a href="/admin/jobs" class="text-primary">View All</a>
    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">
        <table class="min-w-full text-left">
            <thead class="bg-purple-100 text-gray-700">
                <tr>
                    <th class="px-6 py-3 text-sm font-semibold">Title</th>
                    <th class="px-6 py-3 text-sm font-semibold">Location</th>
                    <th class="px-6 py-3 text-sm font-semibold">Experiences</th>
                    <th class="px-6 py-3 text-sm font-semibold">Salary</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {
                    filterData.map((item: any) => {
                        return (
                            <tr>
                                <td class="px-6 py-4">{item.title}</td>
                                <td class="px-6 py-4">{item.location}</td>
                                <td class="px-6 py-4">{item.experience}</td>
                                <td class="px-6 py-4">{item.salary}</td>
                            </tr>
                        )
                    })
                }
            </tbody>
        </table>
    </div>
</div>