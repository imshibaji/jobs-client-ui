---
const { data = [] } = Astro.props;

// sort data by id field as Descending
data.sort((a: any, b: any) => {
  return a.id - b.id;
});

const filterData = data.length > 4 ? data.slice(data.length - 4) : data;
---
<div class="mt-2">
  <div class="flex justify-between items-center mx-3">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Recent Applicants</h2>
      <a href="/admin/applicants" class="text-primary">View All</a>
  </div>
  <div class="bg-white rounded-xl shadow overflow-hidden">
    <table class="min-w-full text-left">
      <thead class="bg-purple-100 text-gray-700">
        <tr>
          <th class="px-6 py-3 text-sm font-semibold">Name</th>
          <th class="px-6 py-3 text-sm font-semibold">Email</th>
          <th class="px-6 py-3 text-sm font-semibold">Mobile</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {
          filterData.map((item: any) => {
            return (
              <tr>
                <td class="px-6 py-4">{item.name}</td>
                <td class="px-6 py-4">{item.email}</td>
                <td class="px-6 py-4">{item.phoneNumber}</td>
              </tr>
            )
          })
        }
      </tbody>
    </table>
  </div>
</div>