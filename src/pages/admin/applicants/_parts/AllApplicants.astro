---
import { BASE_URL } from "astro:env/client";

const { data } = Astro.props;

const searchParams = new URLSearchParams(Astro.url.searchParams);
const q = searchParams.get('q');

const filteredData = data.filter((item: any) => {
  if (q) {
    return (item.name && item.name.toLowerCase().includes(q.toLowerCase())) || item.email.toLowerCase().includes(q.toLowerCase() || item.phoneNumber.toLowerCase().includes(q.toLowerCase()));
  }
  return item;
});

---

<div class="mt-2">
        <div class="grid grid-cols-2 md:grid-cols-3 items-center justify-between mb-4">
          <h2 class="order-1 md:order-1 text-xl font-bold">All Applicants</h2>
          <form class="order-3 md:order-2 my-2 md:my-0 col-span-2 md:col-span-1 flex items-center space-x-0">
            <input name="q" type="text" placeholder="Search..." class="w-full md:w-4xl px-4 py-2 border border-gray-300 rounded-tl-lg rounded-bl-lg focus:outline-none focus:border-violet-500 ">
            <button type="submit" class="bg-violet-600 text-white px-4 py-2 hover:bg-violet-700 transition duration-200">Search</button>
            <a href="/admin/applicants" class="bg-violet-600 text-white px-4 py-2 rounded-tr-lg rounded-br-lg hover:bg-violet-700 transition duration-200 border-l-2 border-violet-400">Reset</a>
          </form>
          <div class="order-2 flex justify-end items-center space-x-2">
            <a href="/admin/applicants/user" class="btn btn-primary">Add Applicant</a>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow overflow-hidden">
          <table class="min-w-full text-left">
            <thead class="bg-purple-100 text-gray-700">
              <tr>
                <th class="px-6 py-3 text-sm font-semibold">Name</th>
                <th class="px-6 py-3 text-sm font-semibold">City</th>
                <th class="px-6 py-3 text-sm font-semibold">Email</th>
                <th class="px-6 py-3 text-sm font-semibold">Phone</th>
                <th class="px-6 py-3 text-sm font-semibold">Resume</th>
                <th class="px-6 py-3 text-sm font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {filteredData && filteredData.map((applicant: any) => (
                <tr>
                  <td class="px-6 py-4">{applicant.name}</td>
                  <td class="px-6 py-4">{applicant.city}</td>
                  <td class="px-6 py-4">{applicant.email}</td>
                  <td class="px-6 py-4">{applicant.phoneNumber}</td>
                  <td class="px-6 py-4">
                    {applicant.resume ? <a class="text-green-600 font-medium hover:underline" href={BASE_URL + `/file/download?Folder=resumes&Filename=${applicant.resume}`} target="_blank">Download Resume</a> : <span class="text-red-600 font-medium">No Resume</span>} 
                  </td>
                  <td class="px-6 py-4">
                    <a href={`/admin/applicants/user/${applicant.id}`} class="text-violet-600 hover:underline ml-2">View & Update</a>
                    <a href={`/admin/applicants/${applicant.id}/delete`} class="text-red-600 hover:underline ml-2">Delete</a>
                  </td>
                </tr>
              ))}
              
