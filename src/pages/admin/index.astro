---
import AdminLayout from "@/layouts/AdminLayout.astro";
import QuickHighlight from "./_parts/QuickHighlight.astro";
// import ActiveJobs from "@/components/back/ActiveJobs.astro";
import RecentApplicants from "./_parts/RecentApplicant.astro";
import RecentCompanies from "./_parts/RecentCompanies.astro";
import RecentJobs from "./_parts/RecentJobs.astro";

import { useHttpClient } from "@/utils/useHttpClient";
import { APP_URL } from "astro:env/server";


const token = Astro.cookies.get('token')?.value as string;
const jobs = await useHttpClient(token).get(APP_URL + '/jobs').then(res => res.json());
const applicants = await useHttpClient(token).get(APP_URL + '/applicants').then(res => res.json());
const companies = await useHttpClient(token).get(APP_URL + '/companies').then(res => res.json());


---
<AdminLayout>
  <QuickHighlight jobs={jobs} applicants={applicants} employers={companies} />
  <!-- <ActiveJobs /> -->
  <div class="grid gap-6 grid-cols-1 lg:grid-cols-2 mt-10">
    <RecentApplicants data={applicants} />
    <RecentCompanies data={companies} />
  </div>
  <RecentJobs data={jobs} />
</AdminLayout>