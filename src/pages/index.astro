<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>JFW — Jobs For Women</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet"/>
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        'plum':       '#1a0d2e',
        'plum-mid':   '#2d1b4e',
        'plum-light': '#3d2660',
        'rose':       '#e891b0',
        'rose-light': '#f2c4d0',
        'rose-deep':  '#d4709a',
      },
      fontFamily: {
        serif: ['"Cormorant Garamond"', 'serif'],
        sans:  ['"DM Sans"', 'sans-serif'],
      },
    }
  }
}
</script>
<style>
/* ── Only what Tailwind cannot express inline ── */
html { scroll-behavior:smooth; }
body { -webkit-font-smoothing:antialiased; overflow-x:hidden; }

/* Particles */
#particles { position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;overflow:hidden; }
.particle  { position:absolute;border-radius:50%;animation:pfloat linear infinite;opacity:0; }
@keyframes pfloat {
  0%   { transform:translateY(100vh) scale(0);opacity:0; }
  10%  { opacity:1; }
  90%  { opacity:.4; }
  100% { transform:translateY(-10vh) scale(1);opacity:0; }
}

/* Page switching */
.pg        { display:none;position:relative;z-index:2; }
.pg.active { display:block; }

/* Scroll-reveal */
.reveal         { opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease; }
.reveal.visible { opacity:1;transform:translateY(0); }
.rd1 { transition-delay:.1s; }
.rd2 { transition-delay:.2s; }
.rd3 { transition-delay:.3s; }
.rd4 { transition-delay:.4s; }

/* Keyframe animations */
@keyframes fadeUp   { from{opacity:0;transform:translateY(26px);} to{opacity:1;transform:translateY(0);} }
@keyframes orbpulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.1);} }
@keyframes blink    { 0%,100%{opacity:1;} 50%{opacity:.3;} }
@keyframes scrollp  { 0%,100%{opacity:.4;} 50%{opacity:1;} }
@keyframes bounce-d { 0%,80%,100%{transform:translateY(0);} 40%{transform:translateY(-7px);} }
@keyframes msgIn    { from{opacity:0;transform:translateY(7px);} to{opacity:1;transform:translateY(0);} }

.anim-1 { animation:fadeUp .8s .10s ease both; }
.anim-2 { animation:fadeUp .8s .22s ease both; }
.anim-3 { animation:fadeUp .8s .32s ease both; }
.anim-4 { animation:fadeUp .8s .42s ease both; }
.anim-5 { animation:fadeUp .8s .52s ease both; }
.anim-6 { animation:fadeUp .8s .90s ease both; }

/* Decorative elements */
.orb   { position:absolute;border-radius:50%;filter:blur(80px);animation:orbpulse 6s ease-in-out infinite; }
.sline { width:1px;height:36px;background:linear-gradient(to bottom,transparent,#e891b0);animation:scrollp 2s ease-in-out infinite; }

/* Nav active state (toggled by JS) */
.nav-btn        { background:transparent;border:none;font-family:"DM Sans",sans-serif;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(240,230,246,.62);padding:.5rem 1rem;border-radius:30px;cursor:pointer;transition:all .2s; }
.nav-btn:hover,
.nav-btn.active { color:#fff;background:rgba(232,145,176,.12); }

/* Modal open toggle (JS adds .open) */
.modal-overlay        { position:fixed;inset:0;background:rgba(10,5,20,.85);backdrop-filter:blur(8px);z-index:500;display:none;align-items:center;justify-content:center;padding:2rem; }
.modal-overlay.open   { display:flex !important; }
.notify-overlay       { position:fixed;inset:0;background:rgba(10,5,20,.8);backdrop-filter:blur(8px);z-index:500;display:none;align-items:center;justify-content:center; }
.notify-overlay.open  { display:flex; }

/* Typing dots */
.msg.typing span { display:inline-block;width:6px;height:6px;background:#e891b0;border-radius:50%;margin:0 2px;animation:bounce-d 1.2s ease-in-out infinite; }
.msg.typing span:nth-child(2) { animation-delay:.2s; }
.msg.typing span:nth-child(3) { animation-delay:.4s; }

/* Chat messages */
.msg      { max-width:84%;padding:.85rem 1.1rem;border-radius:14px;font-size:.86rem;line-height:1.68;animation:msgIn .28s ease; }
.msg.ai   { background:rgba(90,58,138,.5);border:1px solid rgba(232,145,176,.14);color:#f0e6f6;align-self:flex-start;border-radius:3px 14px 14px 14px; }
.msg.user { background:#d4709a;color:white;align-self:flex-end;border-radius:14px 3px 14px 14px; }

/* Founder photo */
.favatar img               { display:none;width:100%;height:100%;object-fit:cover;object-position:center top; }
.favatar.has-photo img     { display:block; }
.favatar.has-photo .initial{ display:none; }

/* tcard shimmer */
.tcard::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(232,145,176,.04),transparent 60%);pointer-events:none; }

/* Scrollbar */
.thin-scroll { scrollbar-width:thin;scrollbar-color:rgba(232,145,176,.3) transparent; }

/* iframe */
.form-iframe { width:100%;height:520px;border:none;border-radius:14px;background:white; }
</style>
</head>
<body class="font-sans bg-plum text-[#f0e6f6]">

<div id="particles"></div>

<!-- ══════════════════════════════
     NOTIFY MODAL
══════════════════════════════ -->
<div class="notify-overlay" id="notify-modal">
  <div class="bg-gradient-to-br from-[rgba(45,27,78,.95)] to-[rgba(26,13,46,.98)] border border-[rgba(232,145,176,.25)] rounded-[22px] p-10 max-w-[420px] w-[90%] relative shadow-[0_30px_80px_rgba(0,0,0,.5)]">
    <button class="absolute top-4 right-5 bg-transparent border-none text-[rgba(240,230,246,.62)] text-xl cursor-pointer hover:text-white transition-colors" onclick="closeNotify()">✕</button>
    <div id="notify-form-wrap">
      <h3 class="font-serif text-[1.6rem] text-white mb-1">🔔 Get Notified</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.7] mb-5">This tool is coming soon! Drop your email and we'll let you know the moment it launches.</p>
      <div class="flex flex-col gap-3">
        <input class="bg-[rgba(26,13,46,.7)] border border-[rgba(232,145,176,.25)] rounded-[10px] px-4 py-[.8rem] text-[.88rem] text-white font-sans outline-none focus:border-rose placeholder-[rgba(240,230,246,.62)] transition-colors" type="text" id="notify-name" placeholder="Your name"/>
        <input class="bg-[rgba(26,13,46,.7)] border border-[rgba(232,145,176,.25)] rounded-[10px] px-4 py-[.8rem] text-[.88rem] text-white font-sans outline-none focus:border-rose placeholder-[rgba(240,230,246,.62)] transition-colors" type="email" id="notify-email" placeholder="Your email address"/>
        <button onclick="submitNotify()" style="justify-content:center" class="inline-flex items-center gap-2 bg-rose-deep text-white px-8 py-[.9rem] rounded-full text-[.88rem] font-medium border-none cursor-pointer font-sans shadow-[0_0_22px_rgba(232,145,176,.45)] hover:shadow-[0_0_40px_rgba(232,145,176,.45)] hover:-translate-y-0.5 transition-all">Notify Me →</button>
      </div>
    </div>
    <div class="hidden text-center py-4" id="notify-success">
      <div class="text-[2.5rem] mb-2">💜</div>
      <p class="text-rose-light text-[.9rem]">You're on the list! We'll notify you as soon as this launches.</p>
    </div>
  </div>
</div>

<!-- ══════════════════════════════
     NAV
══════════════════════════════ -->
<nav class="fixed top-0 left-0 right-0 z-[200] px-[5%] h-[72px] flex items-center justify-between bg-[rgba(26,13,46,.92)] backdrop-blur-xl border-b border-[rgba(232,145,176,.12)]">
  <div class="flex items-center">
    <div class="min-w-[120px] h-[50px] rounded-lg overflow-hidden border-none flex items-center justify-center bg-transparent cursor-pointer relative flex-shrink-0 px-2" id="logoArea" title="JFW — Jobs For Women">
      <img id="logoImg" src="data:image/jpeg;base64," alt="JFW Logo" class="h-full object-contain w-auto block max-h-[45px] max-w-[180px]"/>
    </div>
  </div>
  <ul class="flex gap-1 list-none">
    <li><button onclick="go('home')"    id="nb-home"    class="nav-btn active">Home</button></li>
    <li><button onclick="go('explore')" id="nb-explore" class="nav-btn">Explore</button></li>
    <li><button onclick="openChoice()"
          class="bg-rose-deep text-white px-[1.4rem] py-[.55rem] rounded-full font-sans text-[.78rem] tracking-[.06em] uppercase border-none cursor-pointer shadow-[0_0_18px_rgba(232,145,176,.45)] hover:shadow-[0_0_32px_rgba(232,145,176,.45)] hover:-translate-y-px transition-all">
        Register Now
    </button></li>
  </ul>
</nav>

<!-- ══════════════════════════════
     CHOICE MODAL
══════════════════════════════ -->
<div class="modal-overlay" id="modal-choice">
  <div class="bg-[#1e0f38] border border-[rgba(232,145,176,.2)] rounded-[22px] p-10 max-w-[460px] w-full max-h-[88vh] overflow-y-auto relative text-center">
    <button onclick="closeChoice()" class="absolute top-4 right-4 bg-[rgba(232,145,176,.09)] border border-[rgba(232,145,176,.18)] text-[rgba(240,230,246,.62)] w-8 h-8 rounded-full cursor-pointer text-[.95rem] flex items-center justify-center hover:bg-[rgba(232,145,176,.18)] hover:text-white transition-all font-sans">✕</button>
    <h2 class="font-serif text-[1.7rem] text-white mb-2">Join JFW</h2>
    <p class="text-[.84rem] text-[rgba(240,230,246,.62)] mb-5 leading-relaxed">Are you a candidate looking for opportunities, or a company looking to hire?</p>
    <div class="flex flex-col gap-4 mt-5">
      <a href="https://n8n.jobsforwoman.com/form/registration"
        class="inline-flex items-center justify-center gap-2 bg-rose-deep text-white w-full py-[1.1rem] text-base rounded-full border-none cursor-pointer font-sans shadow-[0_0_22px_rgba(232,145,176,.45)] hover:shadow-[0_0_40px_rgba(232,145,176,.45)] hover:-translate-y-0.5 transition-all">
        👩 I'm a Candidate
      </a>
      <a href="/register-as-employer"
        class="inline-flex items-center justify-center gap-2 text-white w-full py-[1.1rem] text-base rounded-full border border-[rgba(232,145,176,.35)] cursor-pointer font-sans bg-[rgba(212,112,154,.18)] shadow-[0_0_22px_rgba(232,145,176,.22)] hover:shadow-[0_0_40px_rgba(232,145,176,.45)] hover:-translate-y-0.5 transition-all">
        🏢 I'm a Company
      </a>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     HOME PAGE
══════════════════════════════════════════════════════════ -->
<div class="pg active" id="page-home">

<!-- HERO -->
<section class="min-h-screen flex flex-col items-center justify-center text-center px-[5%] pt-28 pb-16 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 90% 70% at 50% 30%,rgba(90,58,138,.5) 0%,transparent 70%),radial-gradient(ellipse 60% 50% at 80% 80%,rgba(212,112,154,.18) 0%,transparent 60%);"></div>
  <div class="orb w-[500px] h-[500px] bg-[rgba(90,58,138,.35)] -top-24 -left-24" style="animation-delay:0s;"></div>
  <div class="orb w-[400px] h-[400px] bg-[rgba(212,112,154,.18)] -bottom-12 -right-20" style="animation-delay:-3s;"></div>

  <div class="anim-1 relative z-10 font-serif font-light text-white leading-none mb-2 tracking-tight drop-shadow-[0_0_80px_rgba(232,145,176,.2)]" style="font-size:clamp(5.5rem,13vw,11rem);">J<span class="text-rose italic">F</span>W</div>
  <div class="anim-2 relative z-10 font-serif italic text-rose-light opacity-[.85] tracking-[.02em] mb-7" style="font-size:clamp(.95rem,1.8vw,1.3rem);">A platform built for women, by women</div>
  <h1 class="anim-3 relative z-10 font-serif font-light text-white max-w-[760px] mx-auto leading-[1.28] mb-4" style="font-size:clamp(1.7rem,3.5vw,2.8rem);">Where Ambition Finds a Home That <em class="italic text-rose">Actually Deserves It</em></h1>
  <p class="anim-4 relative z-10 text-[.96rem] text-[rgba(240,230,246,.62)] max-w-[500px] leading-[1.78] mx-auto mb-9">Built by two women who had enough of systems that weren't built for them. For every woman who feels the same.</p>
  <div class="anim-5 relative z-10 flex gap-4 justify-center flex-wrap">
    <a href="https://n8n.jobsforwoman.com/form/registration" class="inline-flex items-center gap-2 bg-rose-deep text-white px-8 py-[.9rem] rounded-full text-[.88rem] font-medium tracking-[.03em] border-none cursor-pointer font-sans whitespace-nowrap shadow-[0_0_22px_rgba(232,145,176,.45),0_4px_18px_rgba(212,112,154,.4)] hover:shadow-[0_0_40px_rgba(232,145,176,.45),0_8px_28px_rgba(212,112,154,.5)] hover:-translate-y-0.5 transition-all">Join as Candidate →</a>
    <a href="/register-as-employer" class="inline-flex items-center gap-2 text-[#f0e6f6] px-8 py-[.9rem] rounded-full text-[.88rem] whitespace-nowrap border border-[rgba(232,145,176,.35)] cursor-pointer font-sans bg-[rgba(212,112,154,.18)] shadow-[0_0_22px_rgba(232,145,176,.22),0_4px_18px_rgba(212,112,154,.2)] hover:shadow-[0_0_22px_rgba(232,145,176,.22)] hover:-translate-y-0.5 hover:bg-[rgba(232,145,176,.14)] transition-all">Register Company →</a>
  </div>
  <div class="anim-6 absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 z-10">
    <div class="sline"></div>
    <span class="text-[.58rem] tracking-[.18em] uppercase text-[rgba(240,230,246,.62)]">Scroll</span>
  </div>
</section>

<!-- WHY -->
<section class="py-28 px-[5%]">
  <div class="reveal">
    <span class="text-[.65rem] tracking-[.22em] uppercase text-rose font-medium mb-3 block">Why JFW Is Different</span>
    <h2 class="font-serif text-white font-normal leading-[1.2]" style="font-size:clamp(2rem,3.8vw,3rem);">Built with Intent. <em class="italic text-rose">Designed for You.</em></h2>
    <p class="text-[.96rem] text-[rgba(240,230,246,.62)] leading-[1.8] max-w-[520px] mt-3">Every feature, every policy, every partner on JFW answers one question: does this genuinely help women?</p>
  </div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-[1.4rem] mt-12">

    <!-- Card macro -->
    <div class="reveal rd1 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Women-First Culture Review</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">Before any company can list on JFW, they go through our culture review — assessing workplace policies, flexibility options, and their commitment to gender equity. We set the bar. They meet it.</p>
    </div>

    <div class="reveal rd2 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M6 3h12M6 8h12M15 21L9 13H6m3 0h3a4 4 0 000-8H6"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Pay Transparency</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">Every role listed on JFW shows its salary range. No negotiating blind. No discovering a colleague earns more. We insist on transparency because you deserve to know your worth before you apply.</p>
    </div>

    <div class="reveal rd3 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Menstrual Leave Champions</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">Our Premium Partner tier is reserved for companies that mandate menstrual leave as policy. These companies get priority placement, higher visibility, and a verified badge on every listing.</p>
      <div class="inline-flex items-center gap-1 bg-[rgba(232,145,176,.14)] border border-[rgba(232,145,176,.32)] text-rose-light text-[.68rem] px-3 py-[.28rem] rounded-full mt-3">Premium Partner — Menstrual Leave Mandated</div>
    </div>

    <div class="reveal rd1 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Smart Career Matching</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">We match on where you want to go, not just where you've been. Culture fit, flexibility, salary, growth direction — our matching goes deeper than keywords.</p>
    </div>

    <div class="reveal rd2 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Women-Only Community</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">A private space for real conversations — mentorship, referrals, advice, celebrations. No performative cheerleading. Just women genuinely supporting women.</p>
    </div>

    <div class="reveal rd3 bg-[rgba(61,38,96,.55)] border border-[rgba(232,145,176,.2)] rounded-[18px] p-8 backdrop-blur-sm hover:-translate-y-1.5 hover:shadow-[0_18px_50px_rgba(212,112,154,.14)] hover:border-[rgba(232,145,176,.38)] transition-all duration-300">
      <div class="w-12 h-12 bg-gradient-to-br from-[#5a3a8a] to-[#d4709a] rounded-[13px] flex items-center justify-center mb-5 shadow-[0_0_18px_rgba(212,112,154,.28)]">
        <svg class="w-[21px] h-[21px] fill-none stroke-white stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <h3 class="font-serif text-[1.25rem] text-white mb-2 leading-[1.3]">Returnship Ready</h3>
      <p class="text-[.86rem] text-[rgba(240,230,246,.62)] leading-[1.8]">Career gaps are not red flags on JFW. We celebrate women re-entering the workforce and match them with companies that see experience, not absence.</p>
    </div>

  </div>
</section>

<!-- INDUSTRIES -->
<section class="py-28 px-[5%] reveal">
  <span class="text-[.65rem] tracking-[.22em] uppercase text-rose font-medium mb-3 block">Industries We Serve</span>
