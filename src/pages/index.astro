<script is:inline>
// PARTICLES
(function(){
  const c=document.getElementById('particles');
  for(let i=0;i<22;i++){
    const p=document.createElement('div');p.className='particle';
    const s=(Math.random()*3+1).toFixed(1),d=(Math.random()*20+15).toFixed(1),dl=(Math.random()*20).toFixed(1),l=(Math.random()*100).toFixed(1);
    const col=Math.random()>.5?'rgba(232,145,176,':'rgba(180,130,220,';
    p.style.cssText=`width:${s}px;height:${s}px;background:${col}${(Math.random()*.4+.1).toFixed(2)});left:${l}%;animation-duration:${d}s;animation-delay:-${dl}s;`;
    c.appendChild(p);
  }
})();

// NAV
function go(id){
  document.querySelectorAll('.pg').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  document.querySelectorAll('.nav-links button').forEach(b=>b.classList.remove('active'));
  const nb=document.getElementById('nb-'+id);if(nb)nb.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(initRev,100);
}

// LOGO
function uploadLogo(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{
    document.getElementById('logoImg').src=ev.target.result;
    document.getElementById('logoImg').style.display='block';
    document.getElementById('logoArea').classList.add('has-logo');
  };r.readAsDataURL(f);
}

// FOUNDER PHOTOS
function founderPhoto(e,who){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{
    document.getElementById('fimg-'+who).src=ev.target.result;
    document.getElementById('fav-'+who).classList.add('has-photo');
  };r.readAsDataURL(f);
}

// MODALS
function openChoice(){
  var el=document.getElementById('modal-choice');
  if(el){el.classList.add('open');}
}
function closeChoice(){
  var el=document.getElementById('modal-choice');
  if(el){el.classList.remove('open');}
}
function openM(id){
  var el=document.getElementById('modal-'+id);
  if(el){el.classList.add('open');}
}
function closeM(id){
  var el=document.getElementById('modal-'+id);
  if(el){el.classList.remove('open');}
}
document.querySelectorAll('.modal-overlay').forEach(function(m){
  m.addEventListener('click',function(e){if(e.target===m)m.classList.remove('open');});
});

// REVEAL
function initRev(){
  const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');}),{threshold:.06});
  document.querySelectorAll('.reveal').forEach(el=>{if(!el.classList.contains('visible'))obs.observe(el);});
}
initRev();

// MAYA FAQ
const MAYA={
  'jfw':'JFW — Jobs For Women — is India\'s first career platform built exclusively for women. We connect talented women with companies committed to gender equity, pay transparency, and flexible work. Founded by Mahak and Yakshita Tiwari.',
  'register':'Click "Register Now" at the top or any register button on the home page. Choose Candidate or Company — you\'ll be taken straight to our registration form.',
  'founder':'JFW was founded by Mahak Tiwari (Co-Founder) and Yakshita Tiwari (Co-Founder). Mahak built it after watching brilliant women leave jobs because systems failed them. Yakshita joined because she lived the same story and wanted to fix it (loudly). 💜',
  'tool':'JFW has four tools in development: Salary Negotiator, Resume Builder, Mock Interviews, and Skill Certifications. Free downloadable resources — templates and guides — are already available. Full AI-powered features are coming soon!',
  'free':'Yes — JFW is completely free for candidates. No catch. Companies pay to access the talent network.',
  'premium':'Our Premium Partner badge is exclusively for companies that make menstrual leave a mandatory workplace policy — not just an option. These companies receive: priority placement in search results, a verified Premium Partner badge on all their listings, and higher visibility across the JFW platform. It\'s our way of making sure companies that genuinely protect women\'s health get seen first.',
  'menstrual':'Menstrual leave is at the heart of our Premium Partner programme. Any company that mandates menstrual leave as a formal policy — not just "you can take it if you ask nicely" — earns a Premium Partner badge and priority placement on JFW. We think companies that support women\'s health deserve to stand out. And they will.',
  'maya':'Maya is named after the first two letters of both our founders — MAhak and YAkshita. Put them together and you get MAYA. She carries both founders in her name. 💜',
  'industries':'JFW covers 40+ industries — IT, Finance, Healthcare, Media, Legal, Education, Design, Fashion, Startups, NGOs, AI/ML, Gaming, CleanTech, and many more. If women work there, we cover it.',
  'default':'Great question! JFW is in pre-launch — everything we\'re building centres on creating real opportunities for women. Register on the Home page to be first in line when we go live! 💜'
};

function ask(q){document.getElementById('faqIn').value=q;sendMsg();}
function sendMsg(){
  var inp=document.getElementById('faqIn'),q=inp.value.trim();
  if(!q)return;
  var box=document.getElementById('msgs');
  var um=document.createElement('div');um.className='msg user';um.textContent=q;box.appendChild(um);
  inp.value='';
  var tm=document.createElement('div');tm.className='msg ai typing';tm.innerHTML='<span></span><span></span><span></span>';
  box.appendChild(tm);box.scrollTop=box.scrollHeight;
  setTimeout(function(){
    tm.remove();
    var am=document.createElement('div');am.className='msg ai';
    var ql=q.toLowerCase();
    var res=MAYA['default'];
    // Check each key — order matters, most specific first
    if(ql.includes('premium') || ql.includes('partner') || ql.includes('partner program') || ql.includes('premium partner')){res=MAYA['premium'];}
    else if(ql.includes('menstrual') || ql.includes('period leave') || ql.includes('period') || ql.includes('leave policy')){res=MAYA['menstrual'];}
    else if(ql.includes('maya') || ql.includes('why maya') || ql.includes('name') || ql.includes('called')){res=MAYA['maya'];}
    else if(ql.includes('free') || ql.includes('cost') || ql.includes('paid') || ql.includes('charge') || ql.includes('price')){res=MAYA['free'];}
    else if(ql.includes('tool') || ql.includes('feature') || ql.includes('certif') || ql.includes('resume') || ql.includes('salary negot') || ql.includes('interview') || ql.includes('coming soon')){res=MAYA['tool'];}
    else if(ql.includes('register') || ql.includes('sign up') || ql.includes('join') || ql.includes('how do i')){res=MAYA['register'];}
    else if(ql.includes('founder') || ql.includes('mahak') || ql.includes('yakshita') || ql.includes('who built') || ql.includes('who started') || ql.includes('tiwari')){res=MAYA['founder'];}
    else if(ql.includes('industr') || ql.includes('sector') || ql.includes('field') || ql.includes('which industry')){res=MAYA['industries'];}
    else if(ql.includes('jfw') || ql.includes('what is') || ql.includes('jobs for') || ql.includes('platform') || ql.includes('about')){res=MAYA['jfw'];}
    am.textContent=res;box.appendChild(am);box.scrollTop=box.scrollHeight;
  },1100);
}

var notifyTool='';
function openNotify(tool){
  notifyTool=tool;
  document.getElementById('notify-modal').classList.add('open');
  document.getElementById('notify-form-wrap').style.display='block';
  document.getElementById('notify-success').style.display='none';
  document.getElementById('notify-name').value='';
  document.getElementById('notify-email').value='';
}
function closeNotify(){
  document.getElementById('notify-modal').classList.remove('open');
}
function submitNotify(){
  var email=document.getElementById('notify-email').value.trim();
  if(!email||!email.includes('@')){alert('Please enter a valid email.');return;}
  document.getElementById('notify-form-wrap').style.display='none';
  document.getElementById('notify-success').style.display='block';
  setTimeout(function(){closeNotify();},3000);
}
document.getElementById('notify-modal').addEventListener('click',function(e){if(e.target===this)closeNotify();});


</script>
